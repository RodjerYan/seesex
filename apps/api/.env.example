# Скопируйте в apps/api/.env перед запуском (cp .env.example apps/api/.env)
# и заполните секреты! Значения ниже — заглушки для локальной разработки.

# --- База данных: SQLite-файл (в проде он синхронизируется с Google Drive) ---
DATABASE_URL=file:./dev.db
# Путь к файлу БД. В проде boot.ts выставляет его сам (по умолчанию apps/api/data/seesex.db).
# SQLITE_PATH=

# --- Google Drive (OAuth пользователя; запись от его имени) ---
# OAuth-клиент: Google Cloud Console -> Google Auth Platform -> Clients (Web application).
# Redirect URI: https://<домен-приложения>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# id папки на Drive, где лежит seesex.db
GOOGLE_DRIVE_FOLDER_ID=
# Как часто проверять изменения и заливать снапшот (мс, минимум 10000)
DRIVE_SYNC_INTERVAL_MS=60000

# --- Безопасность (СМЕНИТЬ в production!) ---
# 32+ случайных байта, например: openssl rand -base64 48
JWT_SECRET=change-me-local-dev-jwt-secret
# 32 байта base64 для AES-256-GCM, например: openssl rand -base64 32
ENCRYPTION_KEY=change-me-local-dev-encryption-key

# --- CORS / фронтенд ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Сервер ---
NODE_ENV=development
PORT=3000
