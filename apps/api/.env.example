# Скопируйте в apps/api/.env перед запуском (cp .env.example apps/api/.env)
# и заполните секреты! Значения ниже — заглушки для локальной разработки.

# --- База данных (docker compose up -d поднимает postgres:15) ---
DATABASE_URL=postgresql://xtracker:xtracker_dev_password@localhost:5432/xtracker?schema=public

# --- Безопасность (СМЕНИТЬ в production!) ---
# 32+ случайных байта, например: openssl rand -base64 48
JWT_SECRET=change-me-local-dev-jwt-secret
# 32 байта base64 для AES-256-GCM, например: openssl rand -base64 32
ENCRYPTION_KEY=change-me-local-dev-encryption-key

# --- CORS / фронтенд ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Загрузка файлов ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
MAX_PHOTOS_PER_PARTNER=3

# --- Сервер ---
NODE_ENV=development
PORT=3000
